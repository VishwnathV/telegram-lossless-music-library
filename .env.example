TG_API_ID=123456
TG_API_HASH=replace_with_your_api_hash
TG_SESSION_PATH=./data/telegram
# Comma-separated usernames, invite links, or numeric IDs you are allowed to access.
TG_SOURCES=-1001234567890

DATA_DIR=./data
INCOMING_DIR=./incoming
LIBRARY_DIR=./library
DATABASE_PATH=./data/library.sqlite3
PLAYBACK_CACHE_DIR=./data/playback-cache

# Safety limits for archives and downloads.
MAX_DOWNLOAD_BYTES=10737418240
MAX_ARCHIVE_FILES=5000
MAX_ARCHIVE_BYTES=21474836480
# Telegram permits up to 512 KB; larger chunks reduce round trips on high-latency links.
TELEGRAM_DOWNLOAD_PART_KB=512
KEEP_INCOMING=false
